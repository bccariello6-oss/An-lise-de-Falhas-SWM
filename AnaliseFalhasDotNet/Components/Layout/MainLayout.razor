@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject AuthService AuthService

<div class="h-screen flex flex-col bg-[#F8FAFC] overflow-hidden">
    <div class="no-print h-full flex flex-col">
        <header class="bg-white text-[#171C8F] shadow-md h-20 md:h-24 flex-shrink-0 z-50 border-b-4 border-[#171C8F]">
            <div class="max-w-7xl mx-auto px-4 md:px-6 h-full flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <img src="/images/swm-logo.png" alt="SWM Logo" class="h-10 md:h-12 w-auto" />
                    <div class="w-px h-8 bg-slate-100"></div>
                    <div class="h-10 md:h-12 bg-white rounded-xl p-1.5 shadow-sm border border-slate-100 flex items-center justify-center">
                        <img src="/images/opex-logo-final.png" alt="OPEX" class="h-full w-auto object-contain" style="filter: invert(11%) sepia(85%) saturate(3755%) hue-rotate(234deg) brightness(88%) contrast(98%)" />
                    </div>
                    <div class="hidden lg:block h-10 w-px bg-slate-200 ml-2"></div>
                    <div class="hidden sm:block">
                        <h1 class="font-black text-lg tracking-tight uppercase leading-none text-[#171C8F]">Análise de Falha - AF</h1>
                        <p class="text-[9px] text-[#13aff0] font-bold tracking-[0.25em] uppercase mt-1">SWM Brasil</p>
                    </div>
                </div>
                
                <div class="flex items-center gap-2 sm:gap-6">
                    <nav class="flex gap-1 bg-slate-50 p-1.5 rounded-2xl border border-slate-100">
                        <button @onclick='() => NavigationManager.NavigateTo("/analysis/new")' class="px-4 md:px-6 py-3 rounded-xl transition-all font-black uppercase text-[10px] tracking-wider text-[#171C8F]/50 hover:text-[#171C8F] hover:bg-white">Novo</button>
                        <button @onclick='() => NavigationManager.NavigateTo("/")' class="px-4 md:px-6 py-3 rounded-xl transition-all font-black uppercase text-[10px] tracking-wider bg-[#171C8F] text-white shadow-lg">Dashboard</button>
                        <button @onclick='() => NavigationManager.NavigateTo("/kanban")' class="px-4 md:px-6 py-3 rounded-xl transition-all font-black uppercase text-[10px] tracking-wider text-[#171C8F]/50 hover:text-[#171C8F] hover:bg-white">Kanban</button>
                    </nav>
                    
                    <AuthorizeView>
                        <Authorized>
                            <div class="hidden md:flex items-center gap-3 pl-6 border-l border-slate-100">
                                <div class="text-right">
                                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Responsável</p>
                                    <p class="text-[11px] font-black text-[#171C8F]">@context.User.Identity?.Name</p>
                                </div>
                                <button @onclick="Logout" class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center text-slate-400 hover:text-red-600 hover:bg-red-50 transition-all border border-slate-100" title="Sair">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                </button>
                            </div>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        </header>

        <main id="main-content" class="flex-1 flex flex-col overflow-hidden relative">
            <div id="step-scroll-container" class="flex-1 overflow-y-auto px-2 md:px-4 py-1 md:py-2 custom-scrollbar">
                <div class="max-w-[1600px] mx-auto flex flex-col">
                    <div class="bg-white rounded-[24px] shadow-xl shadow-slate-200/50 border border-slate-100 p-3 md:p-5 mb-3 mt-1 md:mt-2">
                        @Body
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

@code {
    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login", true);
    }
}
