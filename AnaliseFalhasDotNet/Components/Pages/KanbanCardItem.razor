@using AnaliseFalhasDotNet.Models

<div class="bg-white p-3 rounded-xl shadow-sm border border-slate-200 hover:shadow-md transition-shadow cursor-grab relative group">
    <div class="flex justify-between items-start mb-2">
        <span class="inline-flex px-1.5 py-0.5 rounded text-[8px] font-black uppercase tracking-widest @(Action.Type == ActionType.Containment ? "bg-purple-100 text-purple-700" : "bg-blue-100 text-blue-700")">
            @(Action.Type == ActionType.Containment ? "Contenção" : "Definitiva")
        </span>
    </div>
    
    <p class="text-xs font-bold text-slate-800 mb-2 leading-snug">
        @Action.What
    </p>

    <div class="space-y-1 border-t border-slate-50 pt-2 mt-2">
        <div class="flex items-center gap-1.5 text-[9px]">
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <span class="font-black text-slate-600 uppercase truncate">@Action.Who</span>
        </div>
        <div class="flex items-center gap-1.5 text-[9px]">
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <span class="font-bold text-slate-500 @(Action.When < DateTime.UtcNow.Date ? "text-red-500" : "")">
                @(Action.When?.ToString("dd/MM/yyyy") ?? "Sem prazo")
            </span>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Models.ActionItem Action { get; set; } = default!;
}
