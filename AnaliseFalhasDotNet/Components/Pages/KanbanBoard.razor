@page "/kanban"
@inject AnalysisService AnalysisService

<div class="h-full flex flex-col p-4 animate-fadeIn">
    <div class="flex justify-between items-center bg-white p-4 rounded-xl shadow-sm border border-slate-100 mb-4">
        <div>
            <h2 class="text-xl font-black text-[#171C8F] tracking-tight">Kanban de Ações</h2>
            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mt-0.5">Acompanhamento e Gestão</p>
        </div>
    </div>

    <!-- Container do Kanban -->
    <div class="flex-1 grid grid-cols-1 md:grid-cols-3 gap-4 min-h-[500px]">
        
        <!-- Coluna ABERTA -->
        <div class="bg-slate-100/50 rounded-2xl p-4 border border-slate-200 flex flex-col h-full overflow-hidden shadow-inner">
            <div class="flex items-center justify-between mb-4 pb-2 border-b-2 border-red-500">
                <h3 class="font-black text-slate-700 uppercase tracking-widest text-sm flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-red-500"></span> Aberta
                </h3>
                <span class="bg-red-100 text-red-600 font-bold px-2 py-0.5 rounded text-xs">
                    @openActions.Count
                </span>
            </div>
            <div class="flex-1 overflow-y-auto custom-scrollbar space-y-3">
                @foreach (var action in openActions)
                {
                    <KanbanCardItem Action="action" />
                }
            </div>
        </div>

        <!-- Coluna EM ANDAMENTO -->
        <div class="bg-slate-100/50 rounded-2xl p-4 border border-slate-200 flex flex-col h-full overflow-hidden shadow-inner">
            <div class="flex items-center justify-between mb-4 pb-2 border-b-2 border-amber-500">
                <h3 class="font-black text-slate-700 uppercase tracking-widest text-sm flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-amber-500"></span> Em andamento
                </h3>
                <span class="bg-amber-100 text-amber-600 font-bold px-2 py-0.5 rounded text-xs">
                    @inProgressActions.Count
                </span>
            </div>
            <div class="flex-1 overflow-y-auto custom-scrollbar space-y-3">
                @foreach (var action in inProgressActions)
                {
                    <KanbanCardItem Action="action" />
                }
            </div>
        </div>

        <!-- Coluna CONCLUÍDA -->
        <div class="bg-slate-100/50 rounded-2xl p-4 border border-slate-200 flex flex-col h-full overflow-hidden shadow-inner">
            <div class="flex items-center justify-between mb-4 pb-2 border-b-2 border-green-500">
                <h3 class="font-black text-slate-700 uppercase tracking-widest text-sm flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-green-500"></span> Concluída
                </h3>
                <span class="bg-green-100 text-green-600 font-bold px-2 py-0.5 rounded text-xs">
                    @completedActions.Count
                </span>
            </div>
            <div class="flex-1 overflow-y-auto custom-scrollbar space-y-3">
                @foreach (var action in completedActions)
                {
                    <KanbanCardItem Action="action" />
                }
            </div>
        </div>

    </div>
</div>

@code {
    private List<Models.ActionItem> openActions = new();
    private List<Models.ActionItem> inProgressActions = new();
    private List<Models.ActionItem> completedActions = new();

    protected override async Task OnInitializedAsync()
    {
        var analyses = await AnalysisService.GetAllAsync();
        var allActions = analyses.SelectMany(a => a.Actions).ToList();

        openActions = allActions.Where(a => a.Status == Models.ActionStatus.Open).ToList();
        inProgressActions = allActions.Where(a => a.Status == Models.ActionStatus.InProgress).ToList();
        completedActions = allActions.Where(a => a.Status == Models.ActionStatus.Completed).ToList();
    }
}
